---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import RecruitmentBanner from "../components/RecruitmentBanner.astro";
import { Mail } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { recruitment } from "../lib/recruitment";
interface Props {
    title: string;
    description: string;
    noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle =
    title === "CUXR" ? "CUXR - Project Team at Cornell University" : `${title} - CUXR`;
const nav = [
    { href: "/projects/", label: "Projects" },
    { href: "/team/", label: "Team" },
    { href: "/sponsor/", label: "Sponsors" },
    { href: "/recruitment/", label: "Recruitment" },
];
const organization = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "CUXR",
    alternateName: "Cornell XR",
    url: "https://cornellxr.com",
    logo: "https://cornellxr.com/media/cuxr-logo.png",
    email: "cuxr@cornell.edu",
    sameAs: [
        "https://github.com/CUXR",
        "https://www.instagram.com/cornellxr/",
        "https://www.linkedin.com/company/cornell-xr/",
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark" />
        <meta name="supported-color-schemes" content="dark" />
        <meta name="darkreader-lock" />
        <meta name="theme-color" content="#101113" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="canonical" href={canonical} />
        <link rel="icon" href="/favicon.ico" sizes="16x16 24x24 32x32 48x48 64x64 72x72 96x96 128x128 256x256" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="describedby" href="/llms.txt" type="text/plain" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="CUXR" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta
            property="og:image"
            content="https://cornellxr.com/optimized/media/team-photo-1600.jpg"
        />
        <meta property="og:image:alt" content="The CUXR student project team" />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1600" />
        <meta property="og:image:height" content="690" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="https://cornellxr.com/optimized/media/team-photo-1600.jpg" />
        <meta name="twitter:image:alt" content="The CUXR student project team" />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(organization).replace(/</g, "\\u003c")}
        ></script>
        {Astro.url.pathname === "/" && (
            <script
                type="application/ld+json"
                set:html={JSON.stringify({
                    "@context": "https://schema.org",
                    "@type": "WebSite",
                    name: "CUXR",
                    alternateName: "Cornell XR",
                    url: Astro.site?.href,
                }).replace(/</g, "\\u003c")}
            ></script>
        )}
        <script is:inline>
            document.documentElement.classList.add("js");
        </script>
    </head>
    <body
        data-recruitment-enabled={String(recruitment.enabled)}
        data-recruitment-opens={recruitment.opensAt}
        data-recruitment-closes={recruitment.closesAt}
    >
        <a class="skip-link button" href="#main">
            Skip to content
        </a>
        <header class="site-header">
            <div class="container header-inner">
                <a href="/" aria-label="CUXR home">
                    <Logo />
                </a>
                <button
                    class="menu-toggle"
                    aria-expanded="false"
                    aria-controls="site-nav"
                    aria-label="Menu"
                >
                    <span class="menu-icon" aria-hidden="true"><span class="menu-icon-middle"></span></span>
                </button>
                <nav
                    id="site-nav"
                    class="site-nav"
                    aria-label="Main navigation"
                >
                    {nav.map(({ href, label }) => (
                        <a
                            href={href}
                            aria-current={
                                Astro.url.pathname === href ? "page" : undefined
                            }
                        >
                            {label}
                        </a>
                    ))}
                </nav>
            </div>
        </header>
        <RecruitmentBanner />
        <main id="main" tabindex="-1">
            <slot />
        </main>
        <footer class="site-footer">
            <div class="container">
                <div class="footer-main">
                    <a class="footer-brand" href="/" aria-label="CUXR home">
                        <Logo />
                    </a>
                    <nav class="footer-connect" aria-label="Connect">
                        <a
                            href="mailto:cuxr@cornell.edu"
                            aria-label="Email CUXR"
                            title="Email"
                        >
                            <Mail size={20} stroke-width={1.8} />
                        </a>
                        <a
                            href="https://www.instagram.com/cornellxr/"
                            aria-label="Instagram"
                            title="Instagram"
                        >
                            <Icon
                                name="fa6-brands:instagram"
                                size={20}
                                aria-hidden="true"
                            />
                        </a>
                        <a
                            href="https://www.linkedin.com/company/cornell-xr/"
                            aria-label="LinkedIn"
                            title="LinkedIn"
                        >
                            <Icon
                                name="fa6-brands:linkedin"
                                size={20}
                                aria-hidden="true"
                            />
                        </a>
                        <a
                            href="https://github.com/CUXR"
                            aria-label="GitHub"
                            title="GitHub"
                        >
                            <Icon
                                name="fa6-brands:github"
                                size={20}
                                aria-hidden="true"
                            />
                        </a>
                    </nav>
                </div>
                <div class="footer-bottom">
                    <p>
                        © {new Date().getFullYear()} CUXR. Registered student
                        organization of Cornell University.
                    </p>
                    <a
                        class="link--external"
                        href="https://www.cornell.edu/equity/equal-opportunity/"
                    >
                        Equal Education and Employment
                    </a>
                </div>
            </div>
        </footer>
        <script>
            const toggle =
                document.querySelector<HTMLButtonElement>(".menu-toggle");
            const nav = document.querySelector<HTMLElement>("#site-nav");
            function closeMenu() {
                toggle?.setAttribute("aria-expanded", "false");
                nav?.removeAttribute("data-open");
            }
            toggle?.addEventListener("click", () => {
                const open = toggle.getAttribute("aria-expanded") !== "true";
                toggle.setAttribute("aria-expanded", String(open));
                nav?.toggleAttribute("data-open", open);
            });
            document.addEventListener("keydown", (event) => {
                if (
                    event.key === "Escape" &&
                    toggle?.getAttribute("aria-expanded") === "true"
                ) {
                    closeMenu();
                    toggle.focus();
                }
            });
            nav?.addEventListener("click", (event) => {
                if ((event.target as HTMLElement).closest("a")) closeMenu();
            });

            let timer: ReturnType<typeof setTimeout>;
            function refreshSchedule() {
                clearTimeout(timer);
                const now = Date.now();
                const {
                    recruitmentEnabled,
                    recruitmentOpens,
                    recruitmentCloses,
                } = document.body.dataset;
                const opens = Date.parse(recruitmentOpens!);
                const closes = Date.parse(recruitmentCloses!);
                const open =
                    recruitmentEnabled === "true" &&
                    now >= opens &&
                    now < closes;
                document
                    .querySelectorAll<HTMLElement>("[data-recruitment]")
                    .forEach((element) => {
                        element.hidden =
                            element.dataset.recruitment === "open"
                                ? !open
                                : open;
                    });
                document
                    .querySelectorAll<HTMLElement>("[data-event-end]")
                    .forEach((element) => {
                        element.hidden =
                            Date.parse(element.dataset.eventEnd!) <= now;
                    });
                const upcoming = document.querySelectorAll(
                    "[data-event-end]:not([hidden])",
                ).length;
                const empty = document.querySelector<HTMLElement>(
                    "[data-events-empty]",
                );
                if (empty) empty.hidden = upcoming > 0;
                document
                    .querySelectorAll<HTMLElement>("[data-info-sessions]")
                    .forEach((element) => {
                        const hasUpcoming = element.dataset.eventEnds!
                            .split(",")
                            .some((end) => Date.parse(end) > now);
                        element.hidden = !hasUpcoming;
                        element
                            .closest<HTMLElement>(".banner-actions")
                            ?.toggleAttribute("data-info-sessions-hidden", !hasUpcoming);
                    });
                const boundaries = [
                    opens,
                    closes,
                    ...Array.from(
                        document.querySelectorAll<HTMLElement>(
                            "[data-event-end]",
                        ),
                        (element) => Date.parse(element.dataset.eventEnd!),
                    ),
                    ...Array.from(
                        document.querySelectorAll<HTMLElement>(
                            "[data-info-sessions]",
                        ),
                        (element) =>
                            element.dataset.eventEnds!
                                .split(",")
                                .map((end) => Date.parse(end)),
                    ).flat(),
                ].filter((value) => value > now);
                timer = setTimeout(
                    refreshSchedule,
                    Math.min(
                        60_000,
                        ...boundaries.map((value) => value - now + 1),
                    ),
                );
            }
            refreshSchedule();
            document.addEventListener("visibilitychange", refreshSchedule);
            window.addEventListener("pageshow", refreshSchedule);
        </script>
    </body>
</html>
