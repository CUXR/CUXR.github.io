---
import '../styles/hero.css';
---

<section id="hero" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container hero__layout">
  <button class="hero__bear" type="button" data-hero-bear aria-label="Play bear animation">
    <video
      class="hero__video"
      data-hero-video
      muted
      loop
      playsinline
      preload="none"
      poster="/media/bear-poster.png"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/media/cuxr-hero.mp4" type="video/mp4" />
    </video>
    <canvas class="hero__dots" data-hero-dots width="480" height="480" aria-hidden="true"></canvas>
  </button>

  <div class="hero__content">
    <h1 id="hero-title" class="hero__title" aria-label="CUXR"><span class="hero__cu" aria-hidden="true">CU</span><span class="hero__xr" aria-hidden="true"><span>X</span><span>R</span></span></h1>
    <div class="hero__bottom">
      <p class="hero__description">
        A student-led project team at Cornell building extended reality software, haptic devices, and interactive experiences.
      </p>
      <a class="hero__link" href="/projects/">Explore projects</a>
    </div>
  </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const bear = document.querySelector<HTMLButtonElement>('[data-hero-bear]');
  const dots = document.querySelector<HTMLCanvasElement>('[data-hero-dots]');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (hero) {
    const header = document.querySelector<HTMLElement>('.site-header');
    const banner = document.querySelector<HTMLElement>('.recruit-banner');
    const updateTopOffset = () => {
      hero.style.setProperty('--hero-top-offset', `${(header?.offsetHeight ?? 0) + (banner?.offsetHeight ?? 0)}px`);
    };
    const topObserver = new ResizeObserver(updateTopOffset);
    if (header) topObserver.observe(header);
    if (banner) topObserver.observe(banner);
    updateTopOffset();
  }

  if (hero && bear && video) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let visible = false;
    let manuallyPaused = false;
    let frame = 0;
    let dotFrame = 0;
    let inspecting = false;
    let pointerX = 240;
    let pointerY = 240;
    let flowX = 240;
    let flowY = 240;
    let trailX = 240;
    let trailY = 240;
    let previousTime = 0;
    const mask = document.createElement('canvas');
    mask.width = mask.height = 120;
    const maskContext = mask.getContext('2d');
    const maskPixels = maskContext?.createImageData(120, 120);
    const sample = document.createElement('canvas');
    sample.width = sample.height = 80;
    const sampleContext = sample.getContext('2d', { willReadFrequently: true });
    const dotContext = dots?.getContext('2d');

    const drawDots = (time = performance.now()) => {
      if (!inspecting || !visible || document.hidden || reducedMotion.matches) return;
      const elapsed = Math.min(50, time - previousTime);
      previousTime = time;
      const follow = 1 - Math.exp(-elapsed / 45);
      const linger = 1 - Math.exp(-elapsed / 150);
      flowX += (pointerX - flowX) * follow;
      flowY += (pointerY - flowY) * follow;
      trailX += (flowX - trailX) * linger;
      trailY += (flowY - trailY) * linger;
      if (sampleContext && dotContext && maskContext && maskPixels && video.readyState >= 2) {
        sampleContext.drawImage(video, 0, 0, 80, 80);
        const pixels = sampleContext.getImageData(0, 0, 80, 80).data;
        dotContext.clearRect(0, 0, 480, 480);
        dotContext.fillStyle = '#000';
        dotContext.fillRect(0, 0, 480, 480);
        for (let y = 0; y < 80; y++) {
          for (let x = 0; x < 80; x++) {
            const i = (y * 80 + x) * 4;
            if (pixels[i] < 24) continue;
            dotContext.fillStyle = `rgb(${pixels[i]} ${pixels[i + 1]} ${pixels[i + 2]})`;
            dotContext.beginPath();
            dotContext.arc(x * 6 + 3, y * 6 + 3, 1.2 + pixels[i] / 255, 0, Math.PI * 2);
            dotContext.fill();
          }
        }
        // A continuous field masks the complete dot image, avoiding per-cell seams.
        const phase = time / 3000;
        for (let y = 0; y < 120; y++) {
          for (let x = 0; x < 120; x++) {
            const px = x * 4;
            const py = y * 4;
            const warpX = 11 * Math.sin(py * .035 + phase);
            const warpY = 9 * Math.sin(px * .04 - phase * .8);
            const dx = px - flowX + warpX;
            const dy = py - flowY + warpY;
            const tx = px - trailX + warpX;
            const ty = py - trailY + warpY;
            const field = Math.exp(-(dx * dx / 4900 + dy * dy / 3600))
              + .6 * Math.exp(-(tx * tx / 3600 + ty * ty / 2500));
            const blend = Math.max(0, Math.min(1, (field - .28) / .65));
            maskPixels.data[(y * 120 + x) * 4 + 3] = blend * blend * (3 - 2 * blend) * 255;
          }
        }
        maskContext.putImageData(maskPixels, 0, 0);
        dotContext.globalCompositeOperation = 'destination-in';
        dotContext.drawImage(mask, 0, 0, 480, 480);
        dotContext.globalCompositeOperation = 'source-over';
        bear.classList.add('has-dots');
      }
      dotFrame = requestAnimationFrame(drawDots);
    };
    const inspect = () => {
      if (reducedMotion.matches) return;
      if (!inspecting) {
        flowX = trailX = pointerX;
        flowY = trailY = pointerY;
      }
      previousTime = performance.now();
      inspecting = true;
      cancelAnimationFrame(dotFrame);
      drawDots();
    };
    const stopInspecting = () => {
      inspecting = false;
      cancelAnimationFrame(dotFrame);
      bear.classList.remove('has-dots');
    };
    bear.addEventListener('pointerenter', (event) => {
      if (!finePointer.matches) return;
      const bounds = bear.getBoundingClientRect();
      pointerX = (event.clientX - bounds.left) / bounds.width * 480;
      pointerY = (event.clientY - bounds.top) / bounds.height * 480;
      inspect();
    });
    bear.addEventListener('pointerleave', stopInspecting);
    bear.addEventListener('focus', () => {
      pointerX = pointerY = 240;
      inspect();
    });
    bear.addEventListener('blur', stopInspecting);
    reducedMotion.addEventListener('change', stopInspecting);

    const updateLabel = () => {
      bear.setAttribute('aria-label', video.paused ? 'Play bear animation' : 'Pause bear animation');
    };

    const syncPlayback = () => {
      if (document.hidden || !visible || reducedMotion.matches || manuallyPaused) {
        video.pause();
        updateLabel();
        return;
      }
      void video.play().then(updateLabel).catch(updateLabel);
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        syncPlayback();
      },
      { threshold: 0.2 },
    );
    observer.observe(hero);

    bear.addEventListener('click', () => {
      if (video.paused) {
        manuallyPaused = false;
        if (visible && !document.hidden) void video.play().then(updateLabel).catch(updateLabel);
      } else {
        manuallyPaused = true;
        video.pause();
      }
      updateLabel();
    });

    document.addEventListener('visibilitychange', syncPlayback);
    reducedMotion.addEventListener('change', syncPlayback);
    video.addEventListener('play', updateLabel);
    video.addEventListener('pause', updateLabel);

    bear.addEventListener('pointermove', (event) => {
      if (!finePointer.matches || reducedMotion.matches) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const bounds = bear.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        pointerX = (x + 0.5) * 480;
        pointerY = (y + 0.5) * 480;
        bear.style.setProperty('--bear-tilt-x', `${-y * 3}deg`);
        bear.style.setProperty('--bear-tilt-y', `${x * 3}deg`);
      });
    });
    bear.addEventListener('pointerleave', () => {
      cancelAnimationFrame(frame);
      bear.style.removeProperty('--bear-tilt-x');
      bear.style.removeProperty('--bear-tilt-y');
    });
  }
</script>
