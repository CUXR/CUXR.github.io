---
import type { Project } from '../lib/content';
interface Props { projects: Project[] }
const { projects } = Astro.props;
---

<div class="project-index" data-project-index style={`--project-count: ${projects.length}`}>
  <ol class="project-index__list">
    {projects.map((project, index) => (
      <li class="project-index__row" style={`--row: ${index + 1}`}>
        <h2 class="project-index__heading" id={project.id}>
          <a href={`#${project.id}`} data-project-control aria-controls={`details-${project.id}`}>
            <span class="project-index__category">{project.category}</span>
            <span class="project-index__name">{project.title}<span class="project-index__indicator" aria-hidden="true"></span></span>
          </a>
        </h2>
        <div class="project-index__details" id={`details-${project.id}`} role="region" aria-labelledby={project.id}>
          <div class="project-index__detail-content">
          <img src={project.image} alt={project.imageAlt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" width="400" height="320" />
          <p>{project.description}</p>
          </div>
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-project-index]')) {
    const controls = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-project-control]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.project-index__details'));
    const desktop = window.matchMedia('(min-width: 960px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const animations = new Map<HTMLElement, Animation>();
    let activeIndex = -1;

    /** Preserve the current frame when a rapid selection interrupts a transition. */
    function transitionPanel(panel: HTMLElement, active: boolean, animate: boolean) {
      const fromHeight = panel.hidden ? 0 : panel.getBoundingClientRect().height;
      const fromOpacity = panel.hidden ? 0 : Number(getComputedStyle(panel).opacity);
      const fromTransform = panel.hidden ? 'translateY(8px)' : getComputedStyle(panel).transform;
      animations.get(panel)?.cancel();
      animations.delete(panel);
      panel.style.removeProperty('overflow');
      panel.inert = !active;
      panel.setAttribute('aria-hidden', String(!active));
      if (!animate || reducedMotion.matches) {
        panel.hidden = !active;
        return;
      }
      if (!active && panel.hidden) return;
      panel.hidden = false;
      const easing = getComputedStyle(root).getPropertyValue('--ease-out').trim();
      const frames = desktop.matches
        ? [{ opacity: fromOpacity, transform: fromTransform }, { opacity: active ? 1 : 0, transform: active ? 'translateY(0)' : 'translateY(-6px)' }]
        : [{ height: `${fromHeight}px`, opacity: fromOpacity }, { height: `${active ? panel.getBoundingClientRect().height : 0}px`, opacity: active ? 1 : 0 }];
      if (!desktop.matches) panel.style.overflow = 'hidden';
      const animation = panel.animate(frames, { duration: desktop.matches ? 280 : 360, easing });
      animations.set(panel, animation);
      animation.onfinish = () => {
        if (animations.get(panel) !== animation) return;
        panel.hidden = !active;
        panel.style.removeProperty('overflow');
        animations.delete(panel);
      };
    }
    root.dataset.enhanced = 'true';

    function select(index: number, animate = false) {
      if (index === activeIndex && animate) return;
      activeIndex = index;
      controls.forEach((control, position) => {
        const active = position === index;
        control.dataset.active = String(active);
        if (desktop.matches) {
          control.removeAttribute('aria-expanded');
          if (active) control.setAttribute('aria-current', 'true');
          else control.removeAttribute('aria-current');
        } else {
          control.removeAttribute('aria-current');
          control.setAttribute('aria-expanded', String(active));
        }
        transitionPanel(panels[position], active, animate);
      });
    }

    function restoreHash() {
      const index = controls.findIndex((control) => control.hash === window.location.hash);
      if (index < 0) {
        select(0);
        return;
      }
      select(index);
      requestAnimationFrame(() => {
        controls[index].focus({ preventScroll: true });
        controls[index].scrollIntoView({ block: 'nearest', behavior: 'instant' });
      });
    }

    controls.forEach((control, index) => {
      control.addEventListener('pointerenter', (event) => {
        if (desktop.matches && event.pointerType === 'mouse') select(index, true);
      });
      control.addEventListener('focus', () => {
        if (desktop.matches && activeIndex !== index) select(index);
      });
      control.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        select(index, event.detail > 0);
        // Only explicit selections create history; hover remains a temporary preview.
        if (window.location.hash !== control.hash) history.pushState(null, '', control.hash);
        control.focus({ preventScroll: true });
        if (desktop.matches || reducedMotion.matches || event.detail === 0) {
          control.scrollIntoView({ block: 'nearest', behavior: 'instant' });
        } else {
          const pending = Array.from(animations.values(), (animation) => animation.finished.catch(() => {}));
          void Promise.all(pending).then(() => {
            if (activeIndex === index) control.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          });
        }
      });
    });
    window.addEventListener('hashchange', restoreHash);
    desktop.addEventListener('change', () => select(activeIndex));
    reducedMotion.addEventListener('change', () => select(activeIndex));
    restoreHash();
  }
</script>

<style>
  .project-index__list { margin: 0; padding: 0; list-style: none; }
  .project-index__heading { margin: 0; border-top: 1px solid var(--color-border); scroll-margin-block: 24px; }
  .project-index__heading a { display: block; padding: 12px 0 16px; color: var(--color-muted); transition: color 240ms var(--ease-out); }
  .project-index__heading a:is(:hover, :focus-visible, [data-active="true"]) { color: var(--color-text); }
  .project-index__category { display: block; margin-bottom: 4px; font: 400 .75rem/1.5 var(--font-mono); letter-spacing: 0; }
  .project-index__name { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; font-size: clamp(1.65rem, 2.6vw, 2.25rem); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; }
  .project-index__indicator { position: relative; flex: 0 0 18px; width: 18px; height: 18px; align-self: center; color: var(--color-accent); transition: transform var(--duration-fast) var(--ease-out); }
  .project-index__indicator::before, .project-index__indicator::after { position: absolute; content: ''; inset: 8px 0 auto; height: 2px; background: currentColor; transition: transform 280ms var(--ease-out), opacity 240ms var(--ease-out); }
  .project-index__indicator::after { transform: rotate(90deg) scaleX(0); opacity: 0; }
  [data-active="false"] .project-index__indicator::after { transform: rotate(90deg) scaleX(1); opacity: 1; }
  .project-index__heading a:active .project-index__indicator { transform: scale(.92); }
  .project-index__detail-content { padding-bottom: 32px; }
  .project-index__details[hidden] { display: none; }
  .project-index__details img { display: block; width: 100%; height: 280px; object-fit: contain; }
  .project-index__details p { max-width: 48ch; margin: 24px 0 0; color: var(--color-muted); font-size: 1.125rem; line-height: 1.65; }
  @media (min-width: 960px) {
    [data-enhanced] .project-index__list { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); column-gap: clamp(48px, 7vw, 100px); }
    [data-enhanced] .project-index__row { display: contents; }
    [data-enhanced] .project-index__heading { grid-column: 2; grid-row: var(--row); }
    [data-enhanced] .project-index__details { grid-column: 1; grid-row: 1 / span var(--project-count); align-self: start; position: sticky; top: 32px; padding: 0; }
    .project-index__detail-content { padding-bottom: 0; }
    .project-index__details img { height: 320px; }
    .project-index__details p { font-size: clamp(1.125rem, 1.6vw, 1.35rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-index__heading a, .project-index__indicator, .project-index__indicator::before, .project-index__indicator::after { transition: none; }
    .project-index__heading a:active .project-index__indicator { transform: none; }
  }
</style>
