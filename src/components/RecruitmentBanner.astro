---
import { recruitment, isRecruiting, upcomingEvents, deadlineLabel } from '../lib/recruitment';
import { Info } from '@lucide/astro';
const events = upcomingEvents(recruitment);
const deadlineMessage = recruitment.applicationUrl ? 'Applications close' : 'Recruitment closes';
---
<aside class="recruit-banner" aria-label="Recruitment announcement" data-recruitment="open" hidden={!isRecruiting(recruitment)}>
  <div class="container recruit-banner-inner">
    <div class="banner-copy banner-copy--desktop"><strong><span class="banner-title">{recruitment.audience} recruitment</span></strong><span class="banner-deadline">{deadlineMessage} {deadlineLabel(recruitment)}</span></div>
    <a class="banner-copy banner-copy--mobile" href={recruitment.applicationUrl ?? '/recruitment/'}><strong><span class="banner-title">{recruitment.audience} recruitment</span> <span class="banner-outlink" aria-hidden="true">↗</span></strong><span class="banner-deadline">{deadlineMessage} {deadlineLabel(recruitment)}</span></a>
    {(recruitment.applicationUrl || recruitment.coffeeChatUrl || events.length > 0) && <div class="banner-actions">
      {recruitment.applicationUrl && <a class="banner-button banner-button--apply" href={recruitment.applicationUrl}>Apply</a>}
      {recruitment.coffeeChatUrl && <a class="banner-button banner-button--secondary" href={recruitment.coffeeChatUrl} aria-label="Coffee chat"><span aria-hidden="true">☕️</span><span class="banner-action-label">Coffee Chat</span></a>}
      {events.length > 0 && <a class="banner-button banner-button--secondary" href="/recruitment/#info-sessions" aria-label="Info sessions" data-info-sessions data-event-ends={events.map((event) => event.endsAt).join(',')}><Info class="banner-info-icon" size={18} stroke-width={2} aria-hidden="true" /><span class="banner-action-label">Info Sessions</span></a>}
    </div>}
  </div>
</aside>
