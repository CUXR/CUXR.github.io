---
import Layout from "../layouts/Layout.astro";
import ResponsiveImage from "../components/ResponsiveImage";
import Hero from "../components/Hero.astro";
import FeaturedProjects from "../components/FeaturedProjects";
import { projects } from "../lib/content";
import "../styles/home.css";
const featured = projects.filter(
    (project) => project.featured && project.status === "active",
);
---

<Layout
    title="CUXR"
    description="CUXR is a student-led project team at Cornell University building extended reality software, haptic devices, and VR games. Explore our projects and meet the team."
>
    <Hero />
    <FeaturedProjects projects={featured} client:visible />
    <section
        id="about"
        class="home-team section"
        aria-labelledby="home-team-title"
    >
        <div class="container">
            <div class="home-team-intro">
                <h2 id="home-team-title">About CUXR</h2>
                <div>
                    <p class="lede">
                        Founded in 2024, CUXR is a student-led project team
                        focused on extending reality through interactive haptic
                        hardware, reality-blending software, and immersive game
                        development.
                    </p>
                    <a class="text-link" href="/team/">
                        Meet the team
                    </a>
                </div>
            </div>
            <figure class="home-team-photo">
                <ResponsiveImage
                    preset="photo"
                    sizes="(min-width: 1408px) 1280px, calc(100vw - 48px)"
                    src="/media/team-photo.webp"
                    alt="CUXR members together on campus"
                    width={6258}
                    height={2699}
                    loading="lazy"
                />
                <figcaption>
                    <span>CUXR</span>
                    <span>Est. 2024</span>
                </figcaption>
            </figure>
            <div class="company-strip">
                <p>Where our members have worked</p>
                <ul aria-label="Member and alumni employers">
                    <li>
                        <a href="https://www.apple.com/">
                            <img
                                src="/media/apple.svg"
                                alt="Apple"
                                width="44"
                                height="54"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://www.nvidia.com/">
                            <img
                                src="/media/nvidia.svg"
                                alt="NVIDIA"
                                width="202"
                                height="37"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://www.microsoft.com/">
                            <img
                                src="/media/microsoft.svg"
                                alt="Microsoft"
                                width="202"
                                height="43"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://www.optiver.com/">
                            <img
                                src="/media/optiver.svg"
                                alt="Optiver"
                                width="168"
                                height="46"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://www.cmu.edu/">
                            <img
                                src="/media/cmu.png"
                                alt="Carnegie Mellon University"
                                width="54"
                                height="54"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://www.tsinghua.edu.cn/en/">
                            <img
                                src="/media/tsinghua-logo.png"
                                alt="Tsinghua University"
                                width="159"
                                height="50"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://www.rtx.com/">
                            <img
                                src="/media/rtx-white.svg"
                                alt="RTX"
                                width="202"
                                height="50"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://picogrid.com/">
                            <img
                                src="/media/picogrid-wordmark.png"
                                alt="PicoGrid"
                                width="160"
                                height="36"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://www.teradyne.com/">
                            <img
                                src="/media/teradyne.svg"
                                alt="Teradyne"
                                width="202"
                                height="30"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://www.smbcgroup.com/americas/">
                            <img
                                src="/media/smbc.svg"
                                alt="SMBC"
                                width="146"
                                height="42"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://www.genworth.com/">
                            <img
                                src="/media/genworth.svg"
                                alt="Genworth Financial"
                                width="190"
                                height="50"
                                loading="lazy"
                            />
                        </a>
                    </li>
                    <li>
                        <a href="https://avantos.ai/">
                            <img
                                src="/media/avantos.svg"
                                alt="Avantos.ai"
                                width="133"
                                height="50"
                                loading="lazy"
                            />
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </section>
    <script>
        const employerList = document.querySelector<HTMLUListElement>(
            ".company-strip ul",
        );

        if (employerList) {
            const logos = Array.from(
                employerList.querySelectorAll<HTMLLIElement>("li"),
            );
            let lastWidth = 0;

            const balanceEmployerRows = () => {
                const width = employerList.clientWidth;
                if (width === lastWidth) return;
                lastWidth = width;

                employerList
                    .querySelectorAll(".company-strip-break")
                    .forEach((item) => item.remove());

                const gap = parseFloat(getComputedStyle(employerList).columnGap);
                const widths = logos.map((logo) => logo.getBoundingClientRect().width);
                const costs = Array<number>(logos.length + 1).fill(Infinity);
                const next = Array<number>(logos.length).fill(logos.length);
                costs[logos.length] = 0;

                // Balance unused space while keeping at least two logos on every row.
                for (let start = logos.length - 1; start >= 0; start--) {
                    let rowWidth = 0;
                    for (let end = start; end < logos.length; end++) {
                        rowWidth += widths[end] + (end > start ? gap : 0);
                        if (rowWidth > width - 1) break;
                        if (end === start || !Number.isFinite(costs[end + 1]))
                            continue;

                        const cost = (width - rowWidth) ** 2 + costs[end + 1];
                        if (cost < costs[start]) {
                            costs[start] = cost;
                            next[start] = end + 1;
                        }
                    }
                }

                if (!Number.isFinite(costs[0])) return;
                employerList.classList.add("is-balanced");
                for (let start = next[0]; start < logos.length; start = next[start]) {
                    const lineBreak = document.createElement("li");
                    lineBreak.className = "company-strip-break";
                    lineBreak.setAttribute("role", "presentation");
                    lineBreak.setAttribute("aria-hidden", "true");
                    employerList.insertBefore(lineBreak, logos[start]);
                }
            };

            new ResizeObserver(balanceEmployerRows).observe(employerList);
        }
    </script>
    <section
        id="industry-collaboration"
        class="home-industry"
        aria-labelledby="home-industry-title"
    >
        <div class="container home-industry-inner">
            <h2 id="home-industry-title">Industry collaboration</h2>
            <p class="lede">
                We collaborate with industry professionals to exchange ideas,
                learn from their experience, and explore how XR is used in
                practice. These connections bring new perspectives to our work
                and help our members connect what they build with the challenges
                and possibilities of the field. We've hosted speakers from{" "}
                <span class="industry-company">
                    <img
                        src="/media/general-motors.svg"
                        alt=""
                        width="28"
                        height="28"
                        loading="lazy"
                    />
                    General Motors
                </span>{" "}
                on using VR to design new vehicles, and{" "}
                <span class="industry-company">
                    <img
                        src="/media/valve.svg"
                        alt=""
                        width="72"
                        height="20"
                        loading="lazy"
                    />
                    Valve
                </span>{" "}
                on the technology behind VR headsets and Steam Frame.
            </p>
        </div>
    </section>
    <section
        id="join"
        class="home-next section"
        aria-labelledby="home-next-title"
    >
        <div class="container home-next-inner">
            <h2 id="home-next-title" class="sr-only">
                Get involved
            </h2>
            <p class="lede">
                Learn about our subteams and recruitment process, or support our
                projects through sponsorship.
            </p>
            <div class="home-next-actions">
                <a class="button" href="/recruitment/">
                    Join the team
                </a>
                <a class="text-link" href="/sponsor/">
                    Support our work
                </a>
            </div>
        </div>
    </section>
</Layout>
